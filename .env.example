# تنظیمات ربات هوش مصنوعی روباه — این فایل را به .env کپی کنید و مقادیر را وارد کنید.
# در Termux:  cp .env.example .env   سپس:  nano .env
# هشدار: توکن واقعی را هرگز در این فایل نمونه، کد یا گیت‌هاب قرار ندهید.

# توکن ربات رسمی سروش‌پلاس (از BotFather سروش‌پلاس دریافت می‌شود) — الزامی
BOT_TOKEN=

# نشانی پشتیبانی (اختیاری)؛ مثل آی‌دی یا لینک پشتیبانی. اگر خالی باشد، ربات لینک ساختگی نشان نمی‌دهد.
SUPPORT_CONTACT=

# لینک گروه روباه (اختیاری). اگر خالی باشد، ربات لینک ساختگی نشان نمی‌دهد.
FOX_GROUP_URL=

# لینک کانال روباه (اختیاری). اگر خالی باشد، ربات لینک ساختگی نشان نمی‌دهد.
FOX_CHANNEL_URL=
