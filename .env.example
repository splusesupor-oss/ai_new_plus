# تنظیمات ربات هوش مصنوعی روباه — این فایل را به .env کپی کنید و مقادیر را وارد کنید.
# در Termux:  cp .env.example .env   سپس:  nano .env
# هشدار: توکن واقعی و اطلاعات پرداخت را هرگز در این فایل نمونه، کد یا گیت‌هاب قرار ندهید.

# توکن ربات رسمی سروش‌پلاس (از BotFather سروش‌پلاس دریافت می‌شود) — الزامی
BOT_TOKEN=

# نشانی پشتیبانی (اختیاری)؛ مثل آی‌دی یا لینک پشتیبانی. اگر خالی باشد، ربات لینک ساختگی نشان نمی‌دهد.
SUPPORT_CONTACT=

# لینک گروه روباه (اختیاری). اگر خالی باشد، ربات لینک ساختگی نشان نمی‌دهد.
FOX_GROUP_URL=

# لینک کانال روباه (اختیاری). اگر خالی باشد، ربات لینک ساختگی نشان نمی‌دهد.
FOX_CHANNEL_URL=

# شناسه عددی مدیر ربات در سروش‌پلاس (اختیاری ولی برای دریافت رسیدها لازم است).
# این شناسه را از حساب مدیر بگیرید؛ با «شناسه شش‌رقمی داخلی» کاربران فرق دارد.
ADMIN_CHAT_ID=

# اطلاعات پرداخت سفارش ویدیو (در فایل واقعی .env پر شود، نه اینجا).
# اگر خالی باشد، ربات در مرحله پرداخت صادقانه اطلاع می‌دهد که تنظیم نشده است.
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=

# مسیر فایل محلی تصویر راهنمای پرداخت (اختیاری)، مثل: data/payment_guide.jpg
# اگر خالی باشد، تصویر پیش‌فرض پروژه (assets/payment_card.jpg) ارسال می‌شود
# و اگر آن هم نباشد، ربات بدون خطا فقط متن پرداخت را ارسال می‌کند.
PAYMENT_GUIDE_IMAGE=
